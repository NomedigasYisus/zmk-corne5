#define ZMK_POINTING_DEFAULT_MOVE_VAL 800 // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 16    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        swt: switch {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "SWITCH";
            toggle-mode = "on";
        };
    };

    combos {
        compatible = "zmk,combos";

        bluetooth {
            bindings = <&mo 6>;
            key-positions = <34 35>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &kp Q        &kp W       &kp E          &kp R       &kp T        &kp Y        &kp U       &kp I            &kp O         &kp P
  &hm LCTRL A  &hm LALT S  &hm LSHFT D    &hm LWIN F  &hm TAB G    &hm TAB H    &hm RWIN J  &hm RSHFT K      &hm RALT L    &hm RCTRL SEMI
  &kp Z        &kp X       &kp C          &kp V       &kp B        &kp N        &kp M       &kp COMMA        &kp DOT       &kp SQT
  &trans       &trans      &mt LCTRL ESC  &mo 4       &lt 2 SPACE  &lt 3 SPACE  &mo 5       &mt RALT ENTER   &trans        &trans
            >;
        };

        win {
            bindings = <
  &kp Q        &kp W       &kp E          &kp R       &kp T        &kp Y        &kp U       &kp I            &kp O         &kp P
  &hm LWIN A   &hm LALT S  &hm LSHFT D    &hm LCTRL F &hm TAB G    &hm TAB H    &hm RCTRL J &hm RSHFT K      &hm RALT L    &hm RWIN SEMI
  &kp Z        &kp X       &kp C          &kp V       &kp B        &kp N        &kp M       &kp COMMA        &kp DOT       &kp SQT
  &trans       &trans      &mt LCTRL ESC  &mo 4       &lt 2 SPACE  &lt 3 SPACE  &mo 5       &mt RALT ENTER   &trans        &trans
            >;
        };

        function {
            bindings = <
  &kp F1     &kp F2    &kp F3     &kp F4    &kp F5   &kp F6   &kp F7    &kp F8     &kp F9    &kp F10
  &kp LCTRL  &kp LALT  &kp LSHFT  &kp LWIN  &kp TAB  &kp TAB  &kp RWIN  &kp RSHFT  &kp RALT  &kp RCTRL
  &kp F8     &kp F9    &kp F10    &kp F11   &kp F12  &none    &none     &none      &none     &none
  &trans     &trans    &trans     &trans    &trans   &trans   &trans    &trans     &trans    &trans
            >;
        };

        row {
            bindings = <
  &none      &none     &none      &none     &none    &kp INS   &kp PG_UP  &kp UP    &kp PG_DN  &kp LS(LG(S))
  &kp LCTRL  &kp LALT  &kp LSHFT  &kp LWIN  &kp TAB  &kp BSPC  &kp LEFT   &kp DOWN  &kp RIGHT  &kp LS(LG(N4))
  &none      &none     &none      &none     &none    &kp DEL   &kp HOME   &kp LSHFT &kp END    &kp LSHFT
  &trans     &trans    &trans     &trans    &trans   &trans    &trans     &trans    &trans     &trans
            >;
        };

        number {
            bindings = <
  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N7  &kp N8  &kp N9  &kp ASTRK  &kp SLASH
  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp N4  &kp N5  &kp N6  &kp PLUS   &kp MINUS
  &none   &none   &none   &none   &none   &kp N1  &kp N2  &kp N3  &kp DOT    &kp COMMA
  &trans  &trans  &trans  &trans  &trans  &trans  &kp N0  &trans  &trans     &trans
            >;
        };

        simbol {
            bindings = <
  &kp EXCL  &kp AT    &kp LBKT  &kp RBKT  &kp PRCNT  &kp PIPE   &kp BSLH   &kp SLASH  &kp ASTRK  &kp QMARK
  &kp HASH  &kp DLLR  &kp LPAR  &kp RPAR  &kp CARET  &kp GRAVE  &kp EQUAL  &kp MINUS  &kp PLUS   &kp COLON
  &none     &none     &kp LBRC  &kp RBRC  &kp AMPS   &kp TILDE  &kp UNDER  &kp LT     &kp GT     &kp DQT
  &trans    &trans    &trans    &trans    &trans     &trans     &trans     &trans     &trans     &trans
            >;
        };

        adjust {
            bindings = <
  &bt BT_PRV    &bt BT_NXT    &bt BT_CLR_ALL  &bt BT_CLR    &none         &none   &swt 1        &none       &none         &none
  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4  &none   &mkp LCLK     &mkp MCLK   &mkp RCLK     &none
  &none         &none         &none           &none         &none         &none   &kp C_VOL_UP  &kp K_MUTE  &kp C_VOL_DN  &none
  &trans        &trans        &trans          &trans        &trans        &trans  &trans        &trans      &trans        &trans
            >;
        };
    };
};
